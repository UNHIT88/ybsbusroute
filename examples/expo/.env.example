# Copy to .env in your Expo project root

# iOS Simulator / web
EXPO_PUBLIC_YBS_API_URL=http://localhost:8000

# Android Emulator (use this instead of localhost)
# EXPO_PUBLIC_YBS_API_URL=http://10.0.2.2:8000

# Physical phone on same Wi-Fi (replace with your computer's IP)
# EXPO_PUBLIC_YBS_API_URL=http://192.168.1.100:8000

# Deployed API (after Render/Railway deploy)
# EXPO_PUBLIC_YBS_API_URL=https://your-app.onrender.com
